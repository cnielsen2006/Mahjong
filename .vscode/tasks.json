{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Windows player",
            "type": "shell",
            "command": "powershell -NoProfile -File tools\\build_and_test.ps1 -SkipTest",
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": []
        },
        {
            "label": "Build WebGL player",
            "type": "shell",
            "command": "powershell -NoProfile -File tools\\build_webgl.ps1",
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Build and run autotest",
            "type": "shell",
            "command": "powershell -NoProfile -File tools\\build_and_test.ps1",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "Core logic tests",
            "type": "shell",
            "command": "dotnet build -c Release && dotnet bin\\Release\\net9.0\\CoreTests.dll tests",
            "options": { "cwd": "${workspaceFolder}\\tools\\CoreTests" },
            "group": "test",
            "problemMatcher": []
        }
    ]
}
